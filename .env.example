# Required: Cosense project name
COSENSE_PROJECT_NAME=your-project-name

# Required for private projects and write operations: connect.sid cookie value
COSENSE_SID=

# Transport mode: "http" for Claude.ai Custom Connector, "stdio" for Claude Desktop (default)
TRANSPORT=http

# HTTP server port (only used when TRANSPORT=http)
PORT=3000

# --- Authentication for TRANSPORT=http ---
# OAuth 2.1 is the only mechanism both Claude.ai and ChatGPT accept for a
# remote MCP server. Set both of the following to enable it.
#
# Public origin the client will connect to. The resource identifier is derived
# as <origin>/mcp and must match the URL you type into the client exactly.
# MCP_PUBLIC_URL=https://cosense-mcp.example.com
#
# Passphrase for the consent screen (min 12 characters). This is the only
# credential standing between the internet and your Cosense account.
# MCP_OAUTH_PASSPHRASE=

# Where registered clients and issued tokens are persisted. Without it they are
# kept in memory and every restart forces a re-authorization.
# MCP_OAUTH_STORE=/data/oauth-store.json

# Token lifetimes in seconds (defaults: 3600 access, 2592000 refresh)
# MCP_OAUTH_ACCESS_TTL=3600
# MCP_OAUTH_REFRESH_TTL=2592000

# Name shown on the consent screen and in protected resource metadata
# MCP_OAUTH_RESOURCE_NAME=Cosense MCP

# Behind a reverse proxy (Cloudflare Tunnel etc.), restore the client IP so the
# login rate limiter does not treat every request as the same caller.
# MCP_TRUST_PROXY=1

# Comma-separated CORS allowlist for /mcp. Unset means any origin.
# MCP_ALLOWED_ORIGINS=https://claude.ai,https://chatgpt.com

# Fixed Bearer token. Local/CLI fallback only: ChatGPT does not accept custom
# headers at all, and Claude.ai's static_headers support is beta.
# MCP_AUTH_TOKEN=

# Start the HTTP transport with no authentication whatsoever. Only sensible when
# the endpoint is not reachable from the internet.
# MCP_ALLOW_UNAUTHENTICATED=false

# Optional: Page limit for initial resource listing (1-1000, default: 100)
# COSENSE_PAGE_LIMIT=100

# Optional: Sort method for page listing (updated|created|accessed|linked|views|title)
# COSENSE_SORT_METHOD=updated

# Optional: Exclude pinned pages from listing
# COSENSE_EXCLUDE_PINNED=false

# Optional: expose the destructive tools (delete_page / rewrite_page).
# Unset means they are not registered at all, so a model cannot call them.
# Enabling this changes tools/list — reconnect the connector afterwards.
# COSENSE_ENABLE_DELETE=false
